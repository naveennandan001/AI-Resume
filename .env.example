# Application Secrets
SECRET_KEY=super-secret-key-for-hackathon-demo-2026

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./ai_resume.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ai_resume_db

# AI Provider Credentials (Optional for local demo - Smart Fallback Engine active)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
